{
    "name": "koh/ai-workflows",
    "description": "Agentic Workflow Engine for TYPO3 - orchestrates AI actions, content intelligence checks, semantic delivery and human reviews into pipelines",
    "type": "typo3-cms-extension",
    "license": "GPL-2.0-or-later",
    "homepage": "https://ole-hartwig.eu/open-source/ai-workflows",
    "authors": [
        {
            "name": "Kai Ole Hartwig",
            "email": "mail@ole-hartwig.eu",
            "homepage": "https://ole-hartwig.eu",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/ohartwig/ai-workflows/issues",
        "source": "https://github.com/ohartwig/ai-workflows",
        "security": "https://github.com/ohartwig/ai-workflows/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.5.11",
        "symfony/yaml": "^7.4.21",
        "typo3/cms-backend": "^14.0",
        "typo3/cms-core": "^14.0",
        "typo3/cms-extbase": "^14.0",
        "typo3/cms-fluid": "^14.0"
    },
    "require-dev": {
        "koh/dev-typo3": "^1.0"
    },
    "suggest": {
        "koh/content-intelligence": "Provides content quality checks for quality gate steps",
        "koh/semantic-delivery": "Provides multi-channel content transformation"
    },
    "repositories": [
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/175/-/packages/composer/packages.json",
            "only": [
                "hn/typo3-mcp-server",
                "netresearch/nr-passkeys-be"
            ]
        },
        {
            "type": "composer",
            "url": "https://git.ole-hartwig.eu/api/v4/group/1091/-/packages/composer/packages.json",
            "only": [
                "koh/*"
            ]
        }
    ],
    "autoload": {
        "psr-4": {
            "Koh\\AiWorkflows\\": "Classes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Koh\\AiWorkflows\\Tests\\": "Tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "infection/extension-installer": true,
            "phpstan/extension-installer": true,
            "sbuerk/typo3-cmscomposerinstallers-testingframework-bridge": true,
            "typo3/class-alias-loader": true,
            "typo3/cms-composer-installers": true
        }
    },
    "extra": {
        "typo3/cms": {
            "extension-key": "ai_workflows"
        }
    },
    "scripts": {
        "deptrac": "deptrac analyse",
        "phpstan": "phpstan analyse",
        "test": "phpunit -c phpunit.xml --testsuite Unit"
    }
}
